rules_version = '2';
// Shared Firebase project (v88-car-rental-contract).
// - XAUUSD trading terminal data lives ONLY under xau_users/{uid}/... and is private to that signed-in user.
// - Every other collection keeps the car-rental app's previous behaviour (open access) so it doesn't break.
//   TODO: lock the car-rental collections down once that app uses Firebase Authentication.
service cloud.firestore {
  match /databases/{database}/documents {

    // Trading terminal: owner-only.
    match /xau_users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Car-rental app: unchanged (public), but never the trading collection.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'xau_users';
    }
  }
}
